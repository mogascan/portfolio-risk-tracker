# ─────────────────────────────────────────────────────────────────────────────
#  backend/.env.example  —  copy to backend/.env and fill in.
#
#  backend/.env is gitignored. This file is committed and must NEVER hold a real
#  value. Placeholders read <FILL_ME: what to put here>.
#
#  Nothing here is required to run the app or the tests. The suite passes with
#  no secrets at all and CI runs that way deliberately. Each variable unlocks
#  one capability; leaving it blank disables that capability with an explicit
#  "not configured" response — never fabricated data.
#
#  Rewritten 2026-07-28. Every variable below is one the code actually reads,
#  verified by grep. The previous version documented app/config.py, which has
#  since been deleted: API_HOST, API_PORT, CORS_ORIGINS, NEWS_API_KEY, APP_NAME,
#  DATABASE_URL and the Golden Cross settings were read by nothing.
# ─────────────────────────────────────────────────────────────────────────────


# ── ACTIVE ───────────────────────────────────────────────────────────────────
# The only secret currently in use.

# Powers the AI assistant. Without it /api/v1/ai returns a clear error.
OPENAI_API_KEY=<FILL_ME: sk-... from https://platform.openai.com/api-keys>

# Optional — defaults to gpt-4-turbo-preview.
OPENAI_MODEL=gpt-4-turbo-preview
# Optional — only for a proxy or Azure-style endpoint.
# OPENAI_API_BASE=


# ── NEEDED FROM YOU: exchange integration ────────────────────────────────────
# Unlocks GET /api/v1/accounts/{summary,assets,transactions}.
#
# Supported exchanges are COINBASE and KRAKEN. Binance is dropped from scope as
# of 2026-07-28 — see the bottom of this file.
#
# ⚠ CREATE THESE READ-ONLY. Do not enable trading or withdrawal permissions.
#   The app never executes trades, so a key with trade rights is pure added
#   risk with no benefit.

COINBASE_API_KEY=<FILL_ME: read-only key, https://www.coinbase.com/settings/api>
COINBASE_API_SECRET=<FILL_ME: matching secret>
# Only for Coinbase Pro / Advanced Trade keys. Leave blank for standard keys.
COINBASE_PASSPHRASE=

# Kraken: create the key with "Query Funds" and "Query Ledger Entries" only.
# Do NOT grant "Create & Modify Orders" or "Withdraw Funds".
KRAKEN_API_KEY=<FILL_ME: read-only key, https://www.kraken.com/u/security/api>
KRAKEN_API_SECRET=<FILL_ME: matching private key>

# NOTE: the Kraken integration does not exist yet — services/exchanges/kraken.py
# has to be written. These names are here so you can create the key once.


# ── NEEDED FROM YOU: on-chain (Ethereum) ─────────────────────────────────────
# Decided 2026-07-28: Ethereum is being built for real. `web3` is not yet in
# requirements.txt and eth.py's calls are still commented out, so these have no
# effect until that work lands — but the values are needed to verify it.

# An RPC endpoint — a free Alchemy or Infura project URL is enough.
ETHEREUM_RPC_URL=<FILL_ME: e.g. https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY>

# Comma-separated PUBLIC wallet addresses to read balances for.
# ⚠ ADDRESSES ONLY. Never a private key or seed phrase. This app is read-only
#   and will never ask for one — anything that does is a scam.
ETH_WALLET_ADDRESSES=<FILL_ME: 0xabc...,0xdef...>


# ── NEEDED FROM YOU: Reddit ──────────────────────────────────────────────────
# /api/v1/news/reddit/* returns 403 today because the service makes
# unauthenticated requests. `praw` is installed but unused; wiring it up needs
# an app registered under your own account.
#
# Register at https://www.reddit.com/prefs/apps → choose "script".
# These variable names do not exist in the code yet — they arrive with the
# change that authenticates Reddit.

REDDIT_CLIENT_ID=<FILL_ME: the id shown under the app name>
REDDIT_CLIENT_SECRET=<FILL_ME: the secret>
REDDIT_USER_AGENT=<FILL_ME: e.g. crypto-portfolio-tracker/1.0 by u/yourusername>


# ── OPTIONAL ─────────────────────────────────────────────────────────────────

# CoinGecko's free tier needs no key, and free/public is a settled decision
# (no Pro keys). Set only to raise rate limits.
COINGECKO_API_KEY=


# ── CONFIGURATION — not secrets, defaults are fine ───────────────────────────

# development | production. Controls DEBUG.
ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# The frontend hardcodes localhost:8000 in 11 places — changing this breaks it.
PORT=8000

# SQLite is the decided direction but is NOT implemented: db/models.py is empty
# and the database has a 10-table schema with zero rows. Leave False until the
# migration ships; True buys nothing today.
USE_DATABASE=False
# DB_PATH=
# MAIN_DB_URL=
# NEWS_DB_URL=

# Verbose AI pipeline logging.
DEBUG_AI=False


# ── DROPPED — do not fill in ─────────────────────────────────────────────────
# Twitter/X is out of scope as of 2026-07-28. twitter_service.py and
# GET /api/v1/news/twitter/user/{handle} still exist and are reachable, but the
# capability is dropped, not deferred. Setting this switches on a feature the
# project has decided not to have.
#
# TWITTER_BEARER_TOKEN=

# Binance is out of scope as of 2026-07-28. Supported exchanges are Coinbase
# and Kraken. services/exchanges/binance.py remains on disk with 180 lines of
# working ccxt code and is simply not wired in — this was a product choice, not
# a broken integration. python-binance in requirements.txt is now unused.
#
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
